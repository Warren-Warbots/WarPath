{
  "name": "warpath",
  "displayName": "WarPath",
  "publisher": "warpath",
  "version": "0.0.2",
  "icon": "resources/icon.png",
  "author": {
    "name": "Ravi Ponmalai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Warren-Warbots/WarPath.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:java"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "frc-pose-visualizer.openEditor",
        "title": "Open Pose Editor"
      }
    ],
    "configuration": {
      "title": "WarPath",
      "properties": {
        "warpath.robotLength": {
          "type": "number",
          "default": 1.0,
          "minimum": 0.1,
          "maximum": 5.0,
          "markdownDescription": "Robot length in meters (bumper-to-bumper along the robot's forward direction). Used to draw the robot rectangle on the field."
        },
        "warpath.robotWidth": {
          "type": "number",
          "default": 1.0,
          "minimum": 0.1,
          "maximum": 5.0,
          "markdownDescription": "Robot width in meters (bumper-to-bumper perpendicular to forward). Used to draw the robot rectangle on the field."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "20.x",
    "typescript": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0"
  }
}
